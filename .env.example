# ---- server ----
PORT=4000
MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/kisanpool
JWT_SECRET=change-me
JWT_REFRESH_SECRET=change-me-too
OTP_PROVIDER_API_KEY=              # Fast2SMS API key. Leave blank to log the OTP to the console (demo mode)
FAST2SMS_ROUTE=otp                 # 'otp'  — Fast2SMS's own OTP template; needs website verification
                                   #          on their dashboard, else it fails with status 996
                                   # 'q'    — quick SMS, we supply the text; works on a fresh account
                                   # 'dlt'  — DLT-registered template (set FAST2SMS_SENDER_ID + FAST2SMS_MESSAGE_ID)
FAST2SMS_SENDER_ID=                # only for the 'q'/'dlt' routes
FAST2SMS_MESSAGE_ID=               # only for the 'dlt' route

SARVAM_API_KEY=                    # api-subscription-key header for all Sarvam calls
SARVAM_CHAT_MODEL=                 # optional override; defaults to sarvam-105b (sarvam-m was retired)

GOOGLE_MAPS_API_KEY=               # server-side key — the Directions API must be ENABLED
                                   # and, if the key has API restrictions, Directions must be
                                  # in its allowed list, or routing silently uses straight-line

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PLATFORM_CANCELLATION_FEE_PCT=5
PLATFORM_FEE_PCT=10                # platform's cut of the transporter share

ADMIN_USERNAME=                    # operator console login; defaults to admin/admin with a
ADMIN_PASSWORD=                    # startup warning and an in-app banner until both are set

CLOUDINARY_URL=                    # cloudinary://key:secret@cloud   (blank = local disk fallback)

# ---- mobile (Expo) ----
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_SOCKET_URL=http://localhost:4000
EXPO_PUBLIC_RAZORPAY_KEY_ID=       # public key id only, safe on the client
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=   # separate, app-restricted key

RC_API=
REDIS_URL=